# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# MediMate AI - Secure Authentication Config
# ==========================================

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies and verify auth state
# Must be at least 32 characters long in production environments
SESSION_SECRET="your-strong-random-session-secret-at-least-32-chars-long"

# REQUIRE_EMAIL_VERIFICATION: Set to true to enforce email verification before allowing sign in
# In development, set to false for immediate access; in production, set to true
REQUIRE_EMAIL_VERIFICATION="false"

# SMTP Configuration: Used for sending verification tokens and password reset OTPs/links
SMTP_HOST="smtp.provider.com"
SMTP_PORT="587"
SMTP_USER="smtp-username-or-api-key"
SMTP_PASS="smtp-password-or-secret"
EMAIL_FROM="MediMate AI Security <security@medimate.ai>"

# SMS / OTP Provider Configuration (e.g., Twilio / Fast2SMS / MSG91)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+15550001234"

# DATA_DIR: Directory where database and persistent state files are stored
DATA_DIR="./server/data"
